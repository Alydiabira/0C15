{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('admin.css') }}" rel="stylesheet">
{% endblock %}


{% block body %}
	<div class="container-fluid">
		<div class="row">
			<nav class="col-md-3 col-lg-2 d-none d-md-block bg-dark sidebar min-vh-100 p-4">
				<div class="position-sticky">
					<h1 class="text-white">Admin</h1>

					<ul
						class="nav flex-column">

						{# --- Médias --- #}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_media_index') }}">
								Médias
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_media_add') }}">
								Ajouter un média
							</a>
						</li>

						{% if is_granted('ROLE_INA') %}

							{# --- Albums --- #}
							<li class="nav-item mt-3">
								<a class="nav-link" href="{{ path('admin_album_index') }}">
									Albums
								</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('admin_album_add') }}">
									Ajouter un album
								</a>
							</li>

							{# --- Invités --- #}
							<li class="nav-item mt-3">
								<a class="nav-link" href="{{ path('admin_invite_index') }}">
									Invités
								</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('admin_invite_new') }}">
									Ajouter un invité
								</a>
							</li>

						{% endif %}

						{# --- Auth --- #}
						<li class="nav-item mt-4">
							<a class="nav-link text-danger" href="{{ path('app_logout') }}">
								Déconnexion
							</a>
						</li>

					</ul>
				</div>
			</nav>

			<main class="col-md-9 ms-sm-auto col-lg-10 p-4">
				{% block admin %}{% endblock %}
			</main>
		</div>
	</div>
{% endblock %}
