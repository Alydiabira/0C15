<h1>Invités</h1>

<a href="{{ path('admin_invite_new') }}">Ajouter un invité</a>

<table>
    <tr>
        <th>Nom</th>
        <th>Email</th>
        <th>Bloqué</th>
        <th>Actions</th>
    </tr>

    {% for invite in invites %}
        <tr>
            <td>{{ invite.name }}</td>
            <td>{{ invite.email }}</td>
            <td>{{ invite.isBlocked ? 'Oui' : 'Non' }}</td>
            <td>
                {% if not invite.isBlocked %}
                    <form method="post" action="{{ path('admin_invite_block', {id: invite.id}) }}">
                        <button type="submit">Bloquer</button>
                    </form>
                {% endif %}

                <form method="post" action="{{ path('admin_invite_delete', {id: invite.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_invite_' ~ invite.id) }}">
                    <button type="submit">Supprimer</button>
                </form>
            </td>
        </tr>
    {% endfor %}
</table>
