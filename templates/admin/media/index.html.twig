{% extends 'admin.html.twig' %}


{% block admin %}
	<div class="container mt-4">
		<h1 class="mb-4">Médias</h1>

		<div class="mb-3">
			<a href="{{ path('admin_media_add') }}" class="btn btn-primary">Ajouter un média</a>
		</div>

		<table class="table table-striped align-middle">
			<thead>
				<tr>
					<th>Image</th>
					<th>Titre</th>
					{% if is_granted('ROLE_INA') %}
						<th>Artiste</th>
						<th>Album</th>
					{% endif %}
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for media in medias %}
					<tr>
						<td>
							{% if media.path %}
								<img src="/{{ media.path }}" alt="{{ media.title }}" style="max-height: 60px;">
							{% endif %}
						</td>
						<td>{{ media.title }}</td>

						{% if is_granted('ROLE_INA') %}
							<td>{{ media.user.name ?? '' }}</td>
							<td>{{ media.album.name ?? '' }}</td>
						{% endif %}

						<td>
							{# Bouton Modifier #}
							<a href="{{ path('admin_media_update', {id: media.id}) }}" class="btn btn-warning btn-sm">
								Modifier
							</a>

							{# Formulaire Supprimer (POST + CSRF) #}
							<form method="post" action="{{ path('admin_media_delete', {id: media.id}) }}" style="display:inline-block" onsubmit="return confirm('Supprimer ce média ?');">

								<input type="hidden" name="_token" value="{{ csrf_token('delete_media_' ~ media.id) }}">

								<button class="btn btn-danger btn-sm">
									Supprimer
								</button>
							</form>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5">Aucun média trouvé.</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

		{# Pagination très simple #}
		<nav aria-label="Pagination">
			<ul class="pagination">
				<li class="page-item active">
					<span class="page-link">{{ page }}</span>
				</li>
			</ul>
		</nav>
	</div>
{% endblock %}
