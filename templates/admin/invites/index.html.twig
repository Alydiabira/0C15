{% extends 'admin.html.twig' %}

{% block admin %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1>Invités</h1>
		<a href="{{ path('admin_invite_new') }}" class="btn btn-primary">Ajouter un invité</a>
	</div>

	<table class="table table-striped align-middle">
		<thead>
			<tr>
				<th>Nom</th>
				<th>Email</th>
				<th>Bloqué</th>
				<th>Actions</th>
			</tr>
		</thead>

		<tbody>
			{% for invite in invites %}
				<tr>
					<td>{{ invite.name }}</td>
					<td>{{ invite.email }}</td>
					<td>{{ invite.isBlocked ? 'Oui' : 'Non' }}</td>

					<td>

						{# --- Bouton Révoquer (bloque l'accès) --- #}
						{% if not invite.isBlocked %}
							<form method="post" action="{{ path('admin_invite_revoke', {id: invite.id}) }}" style="display:inline-block" onsubmit="return confirm('Révoquer cet invité ? Il ne pourra plus se connecter et ses photos seront masquées.');">

								<input type="hidden" name="_token" value="{{ csrf_token('revoke_invite_' ~ invite.id) }}">
								<button class="btn btn-warning btn-sm">Révoquer</button>
							</form>
						{% endif %}

						{# --- Bouton Supprimer (POST + CSRF) --- #}
						<form method="post" action="{{ path('admin_invite_delete', {id: invite.id}) }}" style="display:inline-block" onsubmit="return confirm('Supprimer cet invité ? Tous ses médias seront supprimés.');">

							<input type="hidden" name="_token" value="{{ csrf_token('delete_invite_' ~ invite.id) }}">
							<button class="btn btn-danger btn-sm">Supprimer</button>
						</form>

					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
