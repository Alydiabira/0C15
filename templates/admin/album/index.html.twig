{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Albums</h1>
        <a href="{{ path('admin_album_add') }}" class="btn btn-primary">Ajouter</a>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th style="width: 200px;">Actions</th>
            </tr>
        </thead>

        <tbody>
        {% for album in albums %}
            <tr>
                <td>{{ album.name }}</td>

                <td>
                    {# --- Bouton Modifier --- #}
                    <a href="{{ path('admin_album_update', {id: album.id}) }}"
                       class="btn btn-warning btn-sm">
                        Modifier
                    </a>

                    {# --- Formulaire Supprimer (POST + CSRF) --- #}
                    <form method="post"
                          action="{{ path('admin_album_delete', {id: album.id}) }}"
                          style="display:inline-block"
                          onsubmit="return confirm('Supprimer cet album ?');">

                        <input type="hidden" name="_token"
                               value="{{ csrf_token('delete_album_' ~ album.id) }}">

                        <button class="btn btn-danger btn-sm">
                            Supprimer
                        </button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
